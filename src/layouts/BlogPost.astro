---
import type { MarkdownHeading } from 'astro';
import SiteShell from '@/components/SiteShell.astro';
import Comment from '@/components/Comment.astro';
import Toc from '@/components/Toc.astro';
import { comment } from '@/consts';
import ScrollToTop from '@/components/ScrollToTop.astro';
import BackLink from '@/components/ui/BackLink.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string | null;
    tags?: string | string[] | null;
    comment?: boolean | null;
    donate?: boolean | null;
    toc?: boolean | null;
    mathjax?: boolean | null;
    mermaid?: boolean | null;
    ogImage?: string;
  };
  headings: MarkdownHeading[];
}

const {
  frontmatter = {
    title: '',
    comment: false,
    donate: false,
    toc: false,
    mathjax: false,
    mermaid: false,
  },
  headings,
} = Astro.props;
---

<SiteShell
  title={frontmatter.title}
  description={frontmatter.description ?? undefined}
  mathjax={frontmatter.mathjax ?? false}
  mermaid={frontmatter.mermaid ?? false}
  ogImage={frontmatter.ogImage}
  contentClass="article-detail-shell"
>
      <div class="article-detail-grid">
        <div class="article-detail-main">
          <BackLink href="/blog/1" label="ARTICLE" />
          <slot />
          {frontmatter.comment && comment.enable && <Comment />}
        </div>
        <div class="article-detail-aside">
          {frontmatter.toc && <Toc headings={headings} />}
        </div>
        <ScrollToTop />
      </div>
</SiteShell>

<script>
  import { Fancybox } from '@fancyapps/ui';
  import '@fancyapps/ui/dist/fancybox/fancybox.css';

  // Fancybox.bind uses event delegation — binding once is enough and survives
  // ClientRouter navigations (it covers [data-fancybox] elements added later).
  Fancybox.bind('[data-fancybox]');

  // The per-article work below operates on `.markdown-body`, which is re-rendered
  // on every navigation — so re-run it on astro:page-load (fires on first load
  // + each navigation). Otherwise images won't lazy-load / open in the lightbox
  // and links won't open in a new tab on the second blog post you visit.
  function bindBlogPost() {
    const markdownBody = document.querySelector('.markdown-body');
    if (!markdownBody) return;

    let images = markdownBody.querySelectorAll('img');
    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const image = entry.target;
          const data_src = image.getAttribute('data-src');
          const data_alt = image.getAttribute('data-alt');
          image.setAttribute('data-fancybox', 'gallery');
          if (data_src) {
            image.setAttribute('src', data_src);
          }
          if (data_alt) {
            image.setAttribute('alt', data_alt);
          }
          observer.unobserve(image);
        }
      });
    };

    const observer = new IntersectionObserver(callback);
    images.forEach((image) => {
      image.setAttribute('loading', 'lazy');
      image.setAttribute('decoding', 'async');
      const finishImage = () => image.classList.remove('is-loading');
      if (!image.complete) {
        image.classList.add('is-loading');
        image.addEventListener('load', finishImage, { once: true });
        image.addEventListener('error', finishImage, { once: true });
      }
      observer.observe(image);
    });

    var links = markdownBody.querySelectorAll('a');
    // 循环遍历链接标签
    for (var i = 0; i < links.length; i++) {
      const href = links[i].getAttribute('href');
      if (!href || links[i].hasAttribute('data-footnote-backref') || links[i].hasAttribute('data-footnote-ref')) continue;
      const target = new URL(href, window.location.href);
      if (target.origin !== window.location.origin) {
        links[i].setAttribute('target', '_blank');
        links[i].setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  document.addEventListener('astro:page-load', bindBlogPost);
</script>
