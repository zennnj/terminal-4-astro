---
import SiteShell from '@/components/SiteShell.astro';
import Comment from '@/components/Comment.astro';
import Donate from '@/components/Donate.astro';
import { comment, donate } from '@/consts';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { comment?: boolean; donate?: boolean };
  contentClass?: string;
  bodyClass?: string;
}
const { frontmatter = { comment: false, donate: false }, contentClass = '', bodyClass = '' } = Astro.props;
---

<SiteShell title={Astro.props.title} description={Astro.props.description} contentClass={contentClass} bodyClass={bodyClass}>
  <Fragment slot="viewport-decoration"><slot name="viewport-decoration" /></Fragment>
  <slot />
  {donate.enable && frontmatter.donate && <Donate />}
  {comment.enable && frontmatter.comment && <Comment />}
</SiteShell>
