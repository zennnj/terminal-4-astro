---
import IndexPage from "@/layouts/IndexPage.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import {formatDate} from "@/utils/formatDate";
import {sortPostsByDate} from "@/utils/sortPostsByDate";
import {getCollectionByName} from "@/utils/getCollectionByName";
import getUrl from "@/utils/getUrl";
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import '@/styles/pages/content-pages.css';
export async function getStaticPaths() {
  const posts = await getCollectionByName("blog");
  //   过滤没有分类的文章，todo 后期可能会强制需要文章分类
  const tags = getUniqueTags(posts).filter((tag) => tag);
  return tags.map((tag) => {
    return {params: {tag,}, props: {tag,},};
  });
}
const {tag} = Astro.props;
let posts = await getCollectionByName("blog");
const tagPosts = getPostsByTag(posts, tag);
const resultPosts = sortPostsByDate(tagPosts);
---

<IndexPage title={tag} contentClass="utility-shell tag-results-shell">
  <PageHeader title={`#${tag}`} eyebrow="TAGGED ARTICLES" description={`${resultPosts.length} article${resultPosts.length === 1 ? '' : 's'} in this topic.`} />
  {resultPosts.length > 0 ? (
    <div class="content-results">
      {resultPosts.map((post) => (
        <article class="content-result">
          <a href={getUrl(`/articles/${post.id}`)}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}</div>
            <i class="ri-arrow-right-line" aria-hidden="true"></i>
          </a>
        </article>
      ))}
    </div>
  ) : <EmptyState title="No articles found" description="This tag does not have any published articles yet." />}
</IndexPage>
