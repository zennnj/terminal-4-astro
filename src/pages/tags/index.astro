---
import IndexPage from "@/layouts/IndexPage.astro";
import {getCollectionByName} from "@/utils/getCollectionByName";
import getUniqueTags from "@/utils/getUniqueTags";
import getUrl from "@/utils/getUrl";
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import '@/styles/pages/content-pages.css';

const blogs = await getCollectionByName('blog')
let tagArr = getUniqueTags(blogs);
---

<IndexPage title="Tags" contentClass="utility-shell tags-shell">
  <PageHeader title="TAGS" eyebrow="ARTICLE INDEX" description="Browse the archive by topic." />
  {tagArr.length > 0
    ? <div class="tag-cloud">{tagArr.map((tag) => <a class="tag-chip" title={tag} href={getUrl(`/tags/${encodeURIComponent(tag)}`)}>#{tag}</a>)}</div>
    : <EmptyState title="No tags yet" description="Tags will appear here when articles are published." />}
</IndexPage>
