---
import IndexPage from '@/layouts/IndexPage.astro';
import { siteConfig } from '@/config/site';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'site');
if (!page) throw new Error('Missing content entry: src/content/pages/site.md');
const { Content } = await render(page);
---

<IndexPage title="About this site" contentClass="site-about-shell" bodyClass="site-about-route">
  <article class="site-about-page about-gradient-surface">
    <h1>ABOUT SITE</h1>
    <div class="site-about-grid">
      <div class="site-story">
        <div class="site-markdown markdown-body"><Content /></div>
        <section class="site-log" aria-labelledby="site-log-page-heading">
          <h2 id="site-log-page-heading">站点更新日志</h2>
          <ol>
            {page.data.updates.map((entry) => (
              <li><time datetime={entry.date}>{entry.date}</time><span>{entry.text}</span></li>
            ))}
          </ol>
        </section>
      </div>

      <aside class="structure" aria-labelledby="structure-heading">
        <h2 id="structure-heading">Current structure</h2>
        <div class="structure-list">
          {siteConfig.structure.map((item) => (
            <article>
              <h3>{item.label}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </aside>
    </div>
  </article>
</IndexPage>

<style>
  :global(.site-content.site-about-shell) { padding: 0; background: var(--p4-yellow); }
  :global(body.site-about-route) { margin: 0; background: var(--p4-yellow); }
  .site-about-page { min-height: 100svh; margin: 0; padding: clamp(.75rem, 2svh, 1.5rem) clamp(2rem, 6vw, 7rem) clamp(4rem, 7vw, 7rem) clamp(7rem, 11vw, 14rem); color: var(--p4-coral); }
  .site-about-page > h1 { margin: 0 0 clamp(2rem, 4vw, 4rem); color: var(--p4-coral); font: 700 clamp(4.2rem, 9vw, 9rem)/.82 var(--font-title); letter-spacing: -.065em; text-align: right; }
  .site-about-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(320px, .65fr); gap: clamp(3rem, 8vw, 9rem); align-items: start; }
  .site-story { display: grid; gap: clamp(2rem, 4vw, 4rem); }
  .site-markdown { color: var(--p4-coral); font: 700 clamp(1.18rem, 1.8vw, 1.85rem)/1.38 var(--font-about-copy); }
  .site-markdown :global(p) { margin: 0 0 1rem; color: var(--p4-coral) !important; }
  .site-markdown :global(h2) { margin: clamp(1.5rem, 3vw, 2.7rem) 0 .8rem; color: var(--p4-coral); font: 400 clamp(1.05rem, 1.5vw, 1.45rem)/1.25 var(--font-body); }
  .site-markdown :global(ul) { margin: 0; padding-left: 1.35em; color: var(--p4-coral) !important; list-style: disc; }
  .site-markdown :global(li) { margin: .1rem 0; color: var(--p4-coral) !important; }
  .site-log h2 { margin: 0 0 .8rem; color: var(--p4-coral); font: 400 clamp(1.05rem, 1.5vw, 1.45rem)/1.25 var(--font-body); }
  .site-log ol { position: relative; display: grid; gap: .85rem; margin: 0; padding-left: 1.8rem; }
  .site-log ol::before { content: ''; position: absolute; top: .45rem; bottom: .45rem; left: .43rem; width: 3px; border-radius: 999px; background: var(--p4-coral); }
  .site-log li { position: relative; display: grid; grid-template-columns: 10ch 1fr; gap: 1rem; font-size: clamp(1rem, 1.35vw, 1.35rem); line-height: 1.35; }
  .site-log li::before { content: ''; position: absolute; top: .42em; left: -1.72rem; width: .72rem; aspect-ratio: 1; border: 3px solid var(--p4-coral); border-radius: 50%; background: var(--p4-gray); }
  .site-log time { white-space: nowrap; }
  .structure > h2 { margin: 0 0 1.2rem; color: var(--p4-purple); font: 700 clamp(2rem, 3.3vw, 3.5rem)/1 var(--font-title); letter-spacing: -.035em; }
  .structure-list { display: grid; gap: 1.15rem; }
  .structure-list article { position: relative; min-height: 128px; padding: 1.35rem 1.4rem; overflow: hidden; border-radius: 5% 2% 6% 3% / 8% 5% 7% 4%; background: var(--p4-yellow); color: var(--p4-purple); box-shadow: 7px 8px 0 color-mix(in srgb, var(--p4-purple) 7%, transparent); }
  .structure-list article:nth-child(even) { transform: rotate(.6deg); }
  .structure-list h3 { margin: 0 0 1.65rem; color: var(--p4-coral); font: 400 .88rem/1 var(--font-body); }
  .structure-list p { margin: 0; font-size: clamp(1rem, 1.3vw, 1.25rem); line-height: 1.25; }
  @media (max-width: 1000px) {
    .site-about-page { padding: .75rem 1.25rem 5rem; }
    .site-about-grid { grid-template-columns: 1fr; }
    .structure { max-width: 620px; }
  }
  @media (max-width: 560px) {
    .site-about-page > h1 { font-size: 18vw; }
    .site-log li { grid-template-columns: 1fr; gap: .1rem; }
  }
</style>
