---
import { getCollectionByName } from '@/utils/getCollectionByName';
import { orderBySticky } from '@/utils/orderBySticky';

export async function getStaticPaths() {
  const entries = orderBySticky(await getCollectionByName('blog'));
  return Array.from({ length: Math.ceil(entries.length / 10) }, (_, index) => ({
    params: { page: String(index + 1) },
  }));
}

const page = Math.max(Number(Astro.params.page) || 1, 1);
const destination = page === 1 ? '/articles' : `/articles/page/${page}`;
return Astro.redirect(destination, 301);
---
