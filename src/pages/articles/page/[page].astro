---
import ArticleHubPage from '@/layouts/ArticleHubPage.astro';
import { getCollectionByName } from '@/utils/getCollectionByName';
import { orderBySticky } from '@/utils/orderBySticky';

export async function getStaticPaths() {
  const entries = orderBySticky(await getCollectionByName('blog'));
  const totalPages = Math.ceil(entries.length / 10);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { currentPage: index + 2 },
  }));
}

const { currentPage } = Astro.props;
---

<ArticleHubPage {currentPage} />
