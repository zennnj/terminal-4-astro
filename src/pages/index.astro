---
import IndexPage from '@/layouts/IndexPage.astro';
import AskBox from '@/components/AskBox.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomePortal from '@/components/home/HomePortal.astro';
import HomeInfo from '@/components/home/HomeInfo.astro';
import { homeConfig } from '@/config/home';
import '@/styles/pages/home.css';
---

<IndexPage title="Home" contentClass="home-shell" bodyClass="home-page">
  <HomeHero />
  <HomePortal />
  <HomeInfo />
  <AskBox variant="corner" email={homeConfig.footer.email} />
</IndexPage>

<script>
  function initHomeReveals() {
    const targets = [...document.querySelectorAll<HTMLElement>('[data-home-reveal]')];
    if (!targets.length) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    targets.forEach((target) => target.classList.add('is-reveal-ready'));
    if (reducedMotion || !('IntersectionObserver' in window)) {
      targets.forEach((target) => target.classList.add('is-revealed'));
      return;
    }
    const narrowViewport = window.matchMedia('(max-width: 720px)').matches;
    targets.forEach((target) => {
      const threshold = Number(target.dataset.homeRevealThreshold ?? .12);
      const lateStage = target.dataset.homeRevealStage === 'late' && !narrowViewport;
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        target.classList.add('is-revealed');
        observer.disconnect();
      }, {
        threshold,
        rootMargin: lateStage ? '0px 0px -34% 0px' : '0px 0px -12% 0px',
      });
      observer.observe(target);
    });
  }

  document.addEventListener('astro:page-load', initHomeReveals);
</script>
