---
import IndexPage from '@/layouts/IndexPage.astro';
import AskBox from '@/components/AskBox.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomePortal from '@/components/home/HomePortal.astro';
import HomeInfo from '@/components/home/HomeInfo.astro';
import { homeConfig } from '@/config/home';
import '@/styles/pages/home.css';
---

<IndexPage title="Home" contentClass="home-shell" bodyClass="home-page">
  <HomeHero />
  <HomePortal />
  <HomeInfo />
  <AskBox variant="corner" email={homeConfig.footer.email} />
</IndexPage>

<script>
  function initHomeReveals() {
    const panels = [...document.querySelectorAll<HTMLElement>('[data-home-reveal]')];
    if (!panels.length) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    panels.forEach((panel) => panel.classList.add('is-reveal-ready'));
    if (reducedMotion || !('IntersectionObserver' in window)) {
      panels.forEach((panel) => panel.classList.add('is-revealed'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).classList.add('is-revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: .3, rootMargin: '0px 0px -26% 0px' });
    panels.forEach((panel) => observer.observe(panel));
  }

  document.addEventListener('astro:page-load', initHomeReveals);
</script>
