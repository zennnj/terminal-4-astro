---
import { getCollection, render } from 'astro:content';
import IndexPage from '@/layouts/IndexPage.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import '@/styles/pages/gallery.css';

const works = (await getCollection('gallery'))
  .filter((work) => import.meta.env.DEV || !work.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const galleryItems = await Promise.all(works.map(async (work) => ({
  work,
  Content: (await render(work)).Content,
})));
const kindLabel = (kind: string) => ({ fanart: 'FAN ART' }[kind] ?? kind.toUpperCase());
---

<IndexPage title="Gallery" contentClass="gallery-shell">
  <header class="gallery-head">
    <PageHeader title="GALLERY" eyebrow="VISUAL ARCHIVE" description="Illustrations, characters and fan works collected in one place." compact>
      <div class="filters" role="group" aria-label="Artwork type" slot="actions">
        <button class="active" type="button" data-filter="all" aria-pressed="true">ALL</button>
        <button type="button" data-filter="oc" aria-pressed="false">OC</button>
        <button type="button" data-filter="fanart" aria-pressed="false">FAN ART</button>
      </div>
    </PageHeader>
  </header>

  {galleryItems.length > 0 ? (
    <div class="gallery-grid" id="gallery-grid">
      {galleryItems.map(({ work, Content }, index) => {
        const dialogId = `gallery-dialog-${index}`;
        const titleId = `gallery-title-${index}`;
        return (
          <article class="work-card" data-kind={work.data.kind}>
            <button class="work-image-button" type="button" data-gallery-open={dialogId} aria-label={`放大查看：${work.data.title}`}>
              <MediaFrame src={work.data.image} alt={work.data.alt ?? work.data.title} aspectRatio="1 / 1" fit="cover" />
              <span class="view-hint" aria-hidden="true"><i class="ri-fullscreen-line"></i> VIEW</span>
            </button>
            <div class="work-caption">
              <h2>{work.data.title}</h2>
              <time datetime={work.data.date.toISOString()}>{work.data.date.toISOString().slice(0, 10)}</time>
              <div class="work-meta">
                <span class="work-kind">{kindLabel(work.data.kind)}</span>
                <div class="work-tags">
                  {work.data.tags.map((tag) => <span class="work-tag">#{tag}</span>)}
                </div>
              </div>
            </div>

            <dialog class="gallery-dialog" id={dialogId} aria-labelledby={titleId}>
              <div class="dialog-layout">
                <div class="dialog-image">
                  <MediaFrame src={work.data.image} alt={work.data.alt ?? work.data.title} aspectRatio="1 / 1" fit="contain" class="dialog-media" />
                </div>
                <aside class="dialog-description">
                  <button class="dialog-close" type="button" data-gallery-close aria-label="关闭作品预览"><i class="ri-close-line"></i></button>
                  <p class="dialog-kind">{kindLabel(work.data.kind)}</p>
                  <h2 id={titleId}>{work.data.title}</h2>
                  <time datetime={work.data.date.toISOString()}>{work.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                  <div class="dialog-copy"><Content /></div>
                  {work.data.tags.length > 0 && <p class="dialog-tags">{work.data.tags.map((tag) => <span>#{tag}</span>)}</p>}
                </aside>
              </div>
              {galleryItems.length > 1 && (
                <>
                  <button class="dialog-nav dialog-prev" type="button" data-gallery-prev aria-label="Previous artwork"><i class="ri-arrow-left-s-line"></i></button>
                  <button class="dialog-nav dialog-next" type="button" data-gallery-next aria-label="Next artwork"><i class="ri-arrow-right-s-line"></i></button>
                </>
              )}
            </dialog>
          </article>
        );
      })}
    </div>
  ) : (
    <EmptyState icon="ri-image-add-line" title="The frames are ready" description="New artwork will appear here once it is added to the gallery." />
  )}
</IndexPage>

<script>
  function initGallery() {
    const gallery = document.querySelector<HTMLElement>('.gallery-shell');
    if (!gallery || gallery.dataset.ready === 'true') return;
    gallery.dataset.ready = 'true';
    const root = document.documentElement;
    const lockPageScroll = () => {
      if (root.classList.contains('gallery-modal-open')) return;
      root.classList.add('gallery-modal-open');
    };
    const unlockPageScroll = () => {
      root.classList.remove('gallery-modal-open');
    };

    const filterButtons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const dialogs = [...gallery.querySelectorAll<HTMLDialogElement>('.gallery-dialog')];
    const getBrowsableDialogs = () => dialogs.filter((dialog) => {
      const card = dialog.closest<HTMLElement>('.work-card');
      return card && !card.hidden;
    });
    const syncDialogNavigation = () => {
      const hideNavigation = getBrowsableDialogs().length < 2;
      gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-prev], [data-gallery-next]').forEach((button) => {
        button.hidden = hideNavigation;
      });
    };
    const switchDialog = (dialog: HTMLDialogElement, direction: -1 | 1) => {
      const available = getBrowsableDialogs();
      if (available.length < 2) return;
      const currentIndex = available.indexOf(dialog);
      if (currentIndex < 0) return;
      const nextDialog = available[(currentIndex + direction + available.length) % available.length];
      dialog.close();
      nextDialog.showModal();
      lockPageScroll();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filterButtons.forEach((item) => item.classList.toggle('active', item === button));
        filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        const filter = button.dataset.filter;
        gallery.querySelectorAll<HTMLElement>('[data-kind]').forEach((card) => {
          card.hidden = filter !== 'all' && card.dataset.kind !== filter;
        });
        syncDialogNavigation();
      });
    });

    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(button.dataset.galleryOpen ?? '') as HTMLDialogElement | null;
        if (!dialog) return;
        dialog.showModal();
        lockPageScroll();
      });
    });

    dialogs.forEach((dialog) => {
      dialog.querySelector<HTMLButtonElement>('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
      dialog.querySelector<HTMLButtonElement>('[data-gallery-prev]')?.addEventListener('click', () => switchDialog(dialog, -1));
      dialog.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => switchDialog(dialog, 1));
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        switchDialog(dialog, event.key === 'ArrowLeft' ? -1 : 1);
      });
      dialog.addEventListener('close', () => {
        if (!gallery.querySelector('.gallery-dialog[open]')) unlockPageScroll();
      });
    });

    syncDialogNavigation();

    document.addEventListener('astro:before-swap', unlockPageScroll, { once: true });
  }

  document.addEventListener('astro:page-load', initGallery);
</script>
