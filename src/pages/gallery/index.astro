---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import IndexPage from '@/layouts/IndexPage.astro';

const works = (await getCollection('gallery'))
  .filter((work) => !work.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const kindLabel = (kind: string) => ({ fanart: 'FAN ART' }[kind] ?? kind.toUpperCase());
---

<IndexPage title="Gallery" contentClass="gallery-shell">
  <header class="gallery-head">
    <div><p>GALLERY · VISUAL ARCHIVE</p><h1>Gallery</h1></div>
    <div class="filters" role="group" aria-label="Artwork type">
      <button class="active" data-filter="all">ALL</button>
      <button data-filter="oc">OC</button>
      <button data-filter="fanart">FAN ART</button>
    </div>
  </header>

  {works.length > 0 ? (
    <div class="gallery-grid" id="gallery-grid">
      {works.map((work) => (
        <article class="work-card" data-kind={work.data.kind}>
          <Image src={work.data.image} alt={work.data.alt ?? work.data.title} loading="lazy" />
          <div class="work-caption">
            <div><span>{kindLabel(work.data.kind)}</span><h2>{work.data.title}</h2></div>
            <p>{work.data.tags.map((tag) => `#${tag}`).join(' ')}</p>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="empty-state"><i class="ri-image-add-line"></i><h2>The frames are ready</h2><p>New artwork will appear here once it is added to the gallery.</p></div>
  )}
</IndexPage>

<script>
  function bindGalleryFilters() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-filter]').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        const filter = button.dataset.filter;
        document.querySelectorAll<HTMLElement>('[data-kind]').forEach((card) => {
          card.hidden = filter !== 'all' && card.dataset.kind !== filter;
        });
      });
    });
  }
  document.addEventListener('astro:page-load', bindGalleryFilters);
</script>

<style>
  :global(.gallery-shell) { width: var(--article-shell-width); margin: 0 auto; padding: 1rem var(--article-shell-padding-inline) clamp(3rem, 5vw, 5rem); }
  .gallery-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 2rem 0; }
  .gallery-head p { margin: 0; color: var(--p4-coral); font: 400 .72rem/1 var(--font-body); letter-spacing: .16em; }
  .gallery-head h1 { margin: .55rem 0 0; font: 700 clamp(2.8rem, 7vw, 6rem)/.92 var(--font-title); letter-spacing: -.055em; text-transform: uppercase; }
  .filters { display: flex; gap: .4rem; padding: .3rem; border: 1px solid rgba(var(--color-text), .14); border-radius: 999px; }
  .filters button { padding: .35rem .75rem; border-radius: 999px; cursor: pointer; }
  .filters button.active { background: var(--p4-purple); color: var(--p4-yellow); }
  .gallery-grid { columns: 2; column-gap: 1rem; }
  .work-card { break-inside: avoid; margin-bottom: 1rem; overflow: hidden; border-radius: 1rem; background: var(--p4-yellow); }
  .work-card img { width: 100%; }
  .work-caption { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem; }
  .work-caption span, .work-caption p { color: rgb(var(--color-text-dodge)); font-size: .75rem; }
  .work-caption h2 { margin: .2rem 0 0; font: 700 clamp(1.2rem, 2.2vw, 2rem)/1 var(--font-title); }
  .empty-state { padding: 5rem 1rem; border: 1px dashed rgba(var(--color-text), .24); border-radius: 1.2rem; text-align: center; color: rgb(var(--color-text-dodge)); }
  .empty-state i { font-size: 2.5rem; color: rgb(var(--color-text-active)); }
  .empty-state h2 { margin: .75rem 0; color: rgb(var(--color-text)); }
  @media (max-width: 900px) { :global(.gallery-shell) { width: 100%; padding-inline: 1.1rem; } }
  @media (max-width: 620px) { .gallery-head { align-items: start; flex-direction: column; } .gallery-grid { columns: 1; } }
</style>
