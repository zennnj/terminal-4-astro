---
import IndexPage from '@/layouts/IndexPage.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing content entry: src/content/pages/about.md');
const { Content } = await render(page);
---

<IndexPage title={page.data.title}>
  <article class="about-page markdown-body">
    <p class="kicker">ABOUT ME</p>
    <h1>{page.data.title}</h1>
    <div class="about-content"><Content /></div>
  </article>
</IndexPage>

<style>
  .about-page { padding: 2rem 0; }
  .about-page .kicker { color: rgb(var(--color-text-active)); font: 600 .72rem/1 jetbrains-mono, monospace; letter-spacing: .16em; }
  .about-page h1 { margin: .6rem 0 1.5rem; font-size: clamp(2.2rem, 6vw, 4rem); letter-spacing: -.04em; }
  .about-content :global(p:first-child) { max-width: 42rem; font-size: 1.2rem; color: rgb(var(--color-text-dodge)); }
</style>
