---
import { getCollection, render } from 'astro:content';
import IndexPage from '@/layouts/IndexPage.astro';
import BackLink from '@/components/ui/BackLink.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import Toc from '@/components/Toc.astro';
import { getReviewDisplayName } from '@/utils/reviews';

export async function getStaticPaths() {
  const reviews = (await getCollection('reviews')).filter((review) => !review.data.draft);
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

const { review } = Astro.props;
const { Content, headings } = await render(review);
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 4);
const hasToc = tocHeadings.length > 0;
const typeLabel = ({ anime: 'ANI/COMIC' } as Record<string, string>)[review.data.type] ?? review.data.type.toUpperCase();
const displayName = getReviewDisplayName(review.data);
---

<IndexPage title={displayName} contentClass="review-detail-shell">
  <BackLink href="/reviews" label="REVIEW" />
  <article class="review-detail">
    <PageHeader title={displayName} eyebrow={`${typeLabel} REVIEW`} detail compact />
    <div class="review-overview">
      <MediaFrame class="detail-cover" src={review.data.cover} alt={displayName} aspectRatio="4 / 5" />
      <dl>
        <div><dt>NAME</dt><dd>{displayName}</dd></div>
        {review.data.name && review.data.originalName && <div><dt>ORIGINAL NAME</dt><dd>{review.data.originalName}</dd></div>}
        <div><dt>TYPE</dt><dd>{typeLabel}</dd></div>
        <div><dt>AUTHOR / DIRECTOR</dt><dd>{review.data.creator ?? '—'}</dd></div>
        <div><dt>DESCRIPTION</dt><dd>{review.data.summary ?? 'No description yet.'}</dd></div>
        <div><dt>DATE</dt><dd>{review.data.date.getFullYear()}.{review.data.date.getMonth() + 1}</dd></div>
        {review.data.verdict && <div><dt>VERDICT</dt><dd>{review.data.verdict}</dd></div>}
      </dl>
    </div>

    {review.data.notes.length > 0 && <section class="detail-notes"><h2>NOTES</h2>{review.data.notes.map((note) => <blockquote><time>{note.date}</time><p>{note.text}</p></blockquote>)}</section>}
    <section class="final-review">
      <h2>REVIEW</h2>
      <div class:list={['review-content-layout', { 'has-toc': hasToc }]}>
        <div class="markdown-body"><Content /></div>
        {hasToc && <aside class="review-toc"><Toc headings={tocHeadings} /></aside>}
      </div>
    </section>
  </article>
</IndexPage>

<style>
  :global(.review-detail-shell) { width: var(--article-shell-width); margin: 0 auto; padding: clamp(1.5rem, 3vw, 2.5rem) var(--article-shell-padding-inline) clamp(2.5rem, 4vw, 4rem); }
  .review-overview { display: grid; grid-template-columns: minmax(210px, .45fr) minmax(0, 1.55fr); gap: clamp(1.25rem, 2.5vw, 2.5rem); align-items: start; }
  :global(.detail-cover) { border: 1px solid color-mix(in srgb, var(--p4-purple) 70%, transparent); border-radius: var(--radius-control); }
  .review-overview dl { display: grid; gap: .6rem; margin: 0; }
  .review-overview dl > div { display: grid; grid-template-columns: 140px minmax(0, 1fr); column-gap: .85rem; }
  .review-overview dt { color: var(--p4-coral); font: 400 15px/1.6 var(--font-body); letter-spacing: .08em; }.review-overview dd { margin: 0; font: 400 15px/1.6 var(--font-body); }
  .detail-notes, .final-review { margin: clamp(1.75rem, 3vw, 2.75rem) 0 0; }
  .detail-notes h2, .final-review h2 { margin: 0 0 .75rem; font-family: var(--font-title); font-size: var(--markdown-h2-size); font-weight: 700; line-height: 1.25; letter-spacing: -.025em; }
  .detail-notes blockquote { margin: .6rem 0; padding: .7rem .9rem; border-left: 2px solid var(--p4-coral); background: color-mix(in srgb, var(--p4-yellow) 72%, transparent); }
  .detail-notes time { color: var(--purple-soft); font-size: .8rem; }.detail-notes p { margin: .35rem 0 0; }
  .final-review .markdown-body { max-width: var(--reading-width); }
  .review-content-layout.has-toc { display: grid; grid-template-columns: minmax(0, var(--reading-width)) minmax(210px, 240px); gap: clamp(2rem, 3.5vw, 3.5rem); align-items: start; justify-content: space-between; }
  .review-content-layout.has-toc .markdown-body { max-width: none; }
  .review-toc { position: relative; min-width: 0; align-self: stretch; }
  @media (max-width: 1180px) and (min-width: 901px) { .review-content-layout.has-toc { grid-template-columns: minmax(0, 1fr) minmax(190px, 220px); gap: var(--space-6); } }
  @media (max-width: 900px) { :global(.review-detail-shell) { width: 100%; margin-left: 0; padding: 5.5rem 1.1rem 3rem; }.review-overview { grid-template-columns: 1fr; }:global(.detail-cover) { width: min(100%, 430px); }.review-content-layout.has-toc { grid-template-columns: 1fr; }.review-toc { grid-row: 1; margin-bottom: 1.5rem; }.review-toc :global(.toc-container) { position: relative; top: auto; max-height: min(54svh, 520px); } }
  @media (max-width: 560px) { .review-overview dl > div { grid-template-columns: 1fr; gap: .25rem; } }
</style>
