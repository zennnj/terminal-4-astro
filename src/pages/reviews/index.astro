---
import { getCollection } from 'astro:content';
import IndexPage from '@/layouts/IndexPage.astro';
import ReviewHeader from '@/components/reviews/ReviewHeader.astro';
import LatestReview from '@/components/reviews/LatestReview.astro';
import ReviewDirectory from '@/components/reviews/ReviewDirectory.astro';
import ReviewMascot from '@/components/reviews/ReviewMascot.astro';
import '@/styles/pages/reviews.css';

const reviews = (await getCollection('reviews'))
  .filter((review) => !review.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<IndexPage title="Review" contentClass="reviews-shell" bodyClass="reviews-page">
  <ReviewHeader />
  <LatestReview review={reviews[0]} {reviews} />
  <ReviewDirectory {reviews} />
  <ReviewMascot />
</IndexPage>
