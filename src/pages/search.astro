---
import IndexPage from '@/layouts/IndexPage.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import '@/styles/pages/content-pages.css';
---

<IndexPage title="Search" contentClass="utility-shell search-shell">
  <PageHeader title="SEARCH" eyebrow="ARTICLE INDEX" description="Search article titles, descriptions and tags." />
  <label class="search-field" for="search">
    <i class="ri-search-line" aria-hidden="true"></i>
    <input maxlength="64" id="search" placeholder="Search articles..." type="search" name="search" autocomplete="off" />
  </label>
  <p class="search-status" id="search-status" aria-live="polite">Start typing to search the archive.</p>
  <section aria-label="Search results"><div class="content-results" id="results-list"></div></section>
</IndexPage>

<script>
  import Fuse, { type FuseResult } from 'fuse.js';
  import { formatDate } from '@/utils/formatDate';
  import { dealLabel } from '@/utils/dealLabel';
  import getUrl from '@/utils/getUrl';

  interface SearchItem { slug: string; title: string; description?: string | null; date: string | Date; tags?: string | string[] | null; }
  let searchData: SearchItem[] | null = null;
  let fuse: Fuse<SearchItem> | null = null;

  function resultNode(result: FuseResult<SearchItem>) {
    const item = result.item;
    const row = document.createElement('article');
    row.className = 'content-result';
    const link = document.createElement('a');
    link.href = getUrl(`/blog/${item.slug}`);
    const time = document.createElement('time');
    time.dateTime = new Date(item.date).toISOString();
    time.textContent = formatDate(item.date);
    const copy = document.createElement('div');
    const title = document.createElement('h2');
    title.textContent = item.title;
    copy.append(title);
    if (item.description) {
      const description = document.createElement('p');
      description.textContent = item.description;
      copy.append(description);
    }
    const meta = document.createElement('span');
    meta.className = 'content-result-meta';
    meta.textContent = dealLabel(item.tags).map((tag) => `#${tag}`).join(' ');
    link.append(time, copy, meta);
    row.append(link);
    return row;
  }

  function setLoading(results: HTMLElement, status: HTMLElement) {
    status.textContent = 'Searching…';
    const skeleton = document.createElement('div');
    skeleton.className = 'search-skeleton';
    skeleton.setAttribute('aria-hidden', 'true');
    for (let index = 0; index < 3; index += 1) skeleton.append(document.createElement('span'));
    results.replaceChildren(skeleton);
  }

  async function runSearch(term: string, results: HTMLElement, status: HTMLElement) {
    const query = term.trim();
    if (!query) {
      status.textContent = 'Start typing to search the archive.';
      results.replaceChildren();
      return;
    }
    setLoading(results, status);
    try {
      if (!searchData) {
        const response = await fetch(getUrl('/search.json'));
        if (!response.ok) throw new Error('Search index unavailable');
        searchData = await response.json();
      }
      const data = searchData;
      if (!data) throw new Error('Search index unavailable');
      fuse ??= new Fuse(data, { includeScore: true, shouldSort: true, threshold: .42, keys: [{ name: 'title', weight: 1 }, { name: 'description', weight: .72 }, { name: 'tags', weight: .45 }] });
      const matches = fuse.search(query);
      status.textContent = matches.length === 1 ? '1 result found.' : `${matches.length} results found.`;
      results.replaceChildren(...matches.map(resultNode));
      if (matches.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'search-status';
        empty.textContent = 'No matching articles. Try a shorter or broader keyword.';
        results.append(empty);
      }
    } catch {
      status.textContent = 'Search is temporarily unavailable. Please try again.';
      results.replaceChildren();
    }
  }

  function initSearch() {
    const input = document.querySelector<HTMLInputElement>('#search');
    const status = document.querySelector<HTMLElement>('#search-status');
    const results = document.querySelector<HTMLElement>('#results-list');
    if (!input || !status || !results || input.dataset.searchBound === 'true') return;
    input.dataset.searchBound = 'true';
    const initial = new URLSearchParams(window.location.search).get('q') ?? '';
    input.value = initial;
    if (initial) void runSearch(initial, results, status);
    let timer = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      const url = new URL(window.location.href);
      input.value.trim() ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
      window.history.replaceState(null, '', url);
      timer = window.setTimeout(() => void runSearch(input.value, results, status), 140);
    });
  }
  document.addEventListener('astro:page-load', initSearch);
  initSearch();
</script>
