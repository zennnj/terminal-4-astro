---
import IndexPage from "@/layouts/IndexPage.astro";
---
<IndexPage title="Search" contentClass="search-shell">
  <aside class="search-head">
    <p>ARTICLE INDEX</p>
    <label for="search">
      SEARCH
    </label>

    <div class="relative">
      <span class="absolute inset-y-0 flex items-center pl-2 opacity-75">
        <i class="ri-search-line text-skin-active ml-1"></i>
      </span>
      <input
        required
        maxlength="24"
        id="search"
        class="block w-full rounded border mt-4 text-skin-base py-3 pl-10 pr-3 placeholder:italic focus:border-skin-active focus:outline-hidden"
        placeholder="Search articles..."
        type="search"
        name="search"
        autofocus
      />
    </div>
  </aside>
  <p id="searchReadout"></p>
  <section aria-label="Search Results">
    <div id="resultsList"></div>
  </section>
</IndexPage>
<script>
  import DOMPurify from "dompurify";
  import Fuse, { type FuseResult } from "fuse.js";
  import {isNumber} from 'lodash-es'
  import {formatDate} from '../utils/formatDate'
  import {dealLabel} from "../utils/dealLabel";
  import getUrl from "../utils/getUrl";

  interface SearchItem {
    slug: string;
    title: string;
    description?: string | null;
    date: string | Date;
    tags?: string | string[] | null;
  }

  let SEARCH_DATA: SearchItem[] | null = null;
  let FUSE_INSTANCE: Fuse<SearchItem> | null = null;
  const FUSE_OPTIONS = {
    includeScore: true,
    shouldSort: true,
    threshold: 0.5,
    keys: [
      {
        name: 'title',
        weight: 1
      },
      {
        name: 'description',
        weight: 0.75
      }
    ]
  }
  const SPINNER = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#7a5980" viewBox="0 0 256 256" id="spinner"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path>
<style>
#spinner {
    animation: spin 1s linear infinite;
}
@keyframes spin {
    100% {
        transform: rotate(360deg);
    }
}
</style>
</svg>`

  let search: HTMLInputElement | null = null;
  let searchReadout: HTMLElement | null = null;
  let resultsList: HTMLElement | null = null;

  function initSearch() {
    search = document.querySelector<HTMLInputElement>('#search');
    searchReadout = document.querySelector<HTMLElement>('#searchReadout');
    resultsList = document.querySelector<HTMLElement>('#resultsList');
    if (!search || !searchReadout || !resultsList) return;

    const urlParams = DOMPurify.sanitize(new URLSearchParams(window.location.search).get('q') ?? '');
    fetchSearchResults(urlParams);
    search.value = urlParams;
    search.focus();

    const input = search;
    input.addEventListener("input", () => {
      const searchTerm = DOMPurify.sanitize(input.value);
      fetchSearchResults(searchTerm);
      updateSearchPageUrl(searchTerm);
    });
  }

  // ClientRouter does not re-fire DOMContentLoaded on navigation; use
  // astro:page-load so the search box re-initialises on every visit to /search.
  document.addEventListener('astro:page-load', initSearch);

  function updateReadout(length: number | null) {
    if (!searchReadout) return;
    if (isNumber(length)) {
      searchReadout.innerHTML = `<div class="my-2"><span class="px-2 font-bold text-skin-active">${length}</span> results found</div>`
    } else {
      searchReadout.innerHTML = ""
    }
  }

  function updateSearchPageUrl(search: string) {
    const url = new URL(window.location.href);
    url.searchParams.set("q", search);
    window.history.replaceState(null, '', url);
  }

  function generateSearchList(results: FuseResult<SearchItem>[], searchTerm: string) {
    const escapedTerm = searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return results.map(r => {
      const {title, description, date, slug, tags} = r.item
      const reg = new RegExp(escapedTerm, 'gi')
      const titleStr = title.replace(reg, (match: string) => {
        return `<span class="text-skin-active font-bold">${match}</span>`
      })
      const descriptionStr = description ? description.replace(reg, (match: string) => {
        return `<span class="text-skin-active font-bold">${match}</span>`
      }) : ''

      const tagsStr = dealLabel(tags).map((tagName) => (
        `<a class="mr-2 hover:text-skin-active" href=${getUrl("/tags/") + tagName}><i class="ri-hashtag mr-1"></i>${tagName}</a>`
      )).join("")
      return `
        <div class="my-5">
            <a
              class="text-xl underline-offset-4 decoration-skin-base decoration-wavy hover:underline hover:decoration-sky-500 font-bold"
              href=${getUrl("/blog/") + slug}>${titleStr}
            </a>
            <div class="flex items-center my-2">
              <div class="flex items-center mr-2"><i class="ri-calendar-2-fill mr-1"></i>${formatDate(date)}</div>
              ${tagsStr}
            </div>
            <p class="break-all mb-4">${descriptionStr}</p>
        </div>
        <div class="divider-horizontal-mini"></div>`
    }).join("")
  }

  async function fetchSearchResults(search: string) {
    if (!resultsList) return;
    if (!search) {
      updateReadout(null)
      resultsList.innerHTML = ''
      return
    }
    if (search.length === 0) return;
    resultsList.innerHTML = SPINNER;
    if (!SEARCH_DATA) {
      try {
        const res = await fetch(getUrl("/search.json"))
        if (!res.ok) {
          throw new Error("Something went wrong...Please try again.");
        }
        SEARCH_DATA = await res.json()
      } catch (e) {
        console.log(e)
      }
    }
    if (SEARCH_DATA && !FUSE_INSTANCE) {
      FUSE_INSTANCE = new Fuse(SEARCH_DATA, FUSE_OPTIONS)
    }

    if (!FUSE_INSTANCE) return;
    const searchResults = FUSE_INSTANCE.search(search)
    updateReadout(searchResults.length)
    resultsList.innerHTML = searchResults.length > 0 ? generateSearchList(searchResults, search) : ""
  }
</script>

<style>
  :global(.search-shell) { max-width: 1100px; margin: 0 auto; padding-top: clamp(4rem, 9vw, 8rem); }
  .search-head > p { margin: 0 0 .55rem; color: var(--p4-coral); font-size: .72rem; letter-spacing: .16em; }
  .search-head > label { color: var(--p4-purple); font: 700 clamp(3rem, 8vw, 7rem)/.9 var(--font-title); letter-spacing: -.055em; }
  .search-head input { border: 2px solid var(--p4-purple); border-radius: 0; background: var(--p4-yellow); font: 400 clamp(1rem, 1.5vw, 1.2rem)/1 var(--font-body); }
  #searchReadout { color: var(--purple-soft); }
  #resultsList :global(a.text-xl) { color: var(--p4-purple); font-family: var(--font-title); text-decoration-color: var(--p4-coral); }
</style>
