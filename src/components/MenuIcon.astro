---
---
<button type="button" id="menu-icon" class="header-btn" title="Menu">
  <i class="ri-menu-fill"/>
</button>
<button type="button" id="menu-icon-close" class="header-btn hidden" title="Menu">
  <i class="ri-close-fill"></i>
</button>


<script>
  // ClientRouter swaps <body> on every navigation, so direct addEventListener
  // on the buttons is lost after the first page. Delegate from `document`
  // (never swapped) and re-query the elements on each click. Guarded so it
  // stays single-bound even if the script re-executes.
  if (!window.__menuIconBound) {
    window.__menuIconBound = true;
    const toggleHidden = (arr) => arr.forEach((el) => el?.classList.toggle("hidden"));

    document.addEventListener("click", (event) => {
      if (event.target.closest("#menu-icon")) {
        const asideBtn = document.getElementById("aside-btn");
        if (asideBtn && asideBtn.classList.contains("hidden")) {
          // aside bar is open -> close it so only the menu shows
          toggleHidden([
            document.getElementById("aside-btn"),
            document.getElementById("aside-close-btn"),
            document.getElementById("personal-info"),
          ]);
        }
        toggleHidden([
          document.getElementById("menu-icon"),
          document.getElementById("menu-icon-close"),
          document.getElementById("mobile-menu"),
        ]);
      } else if (event.target.closest("#menu-icon-close")) {
        toggleHidden([
          document.getElementById("menu-icon"),
          document.getElementById("menu-icon-close"),
          document.getElementById("mobile-menu"),
        ]);
      }
    });
  }
</script>
