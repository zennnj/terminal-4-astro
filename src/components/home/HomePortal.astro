---
import { homeConfig } from '@/config/home';
import getUrl from '@/utils/getUrl';
---

<section class="home-panel portal-panel" id="explore" aria-labelledby="portal-heading">
  <h1 class="portal-heading" id="portal-heading">
    {homeConfig.navigation.heading.map((line) => <span>{line}</span>)}
  </h1>
  <nav class="portal-grid" aria-label="Featured navigation">
    {homeConfig.navigation.items.map((item) => (
      <a class="portal-link" href={getUrl(item.href)}>
        <span class="portal-art" style={`--portal-mask: url("${getUrl(item.mask)}")`}>
          <img class="portal-image" src={getUrl(item.image)} alt="" loading="lazy" />
          <img class="portal-outline" src={getUrl(item.outline)} alt="" aria-hidden="true" loading="lazy" />
        </span>
        <span class="portal-label">{item.label}</span>
      </a>
    ))}
  </nav>
</section>
