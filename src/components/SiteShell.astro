---
import BaseHead from '@/components/BaseHead.astro';
import { config } from '@/consts';
import getUrl from '@/utils/getUrl';
import GlobalFooter from '@/components/GlobalFooter.astro';

interface Props {
  title?: string;
  description?: string;
  mathjax?: boolean;
  mermaid?: boolean;
  ogImage?: string;
  contentClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  mathjax = false,
  mermaid = false,
  ogImage,
  contentClass = '',
  bodyClass = '',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHomepage = currentPath === '/';
const usesRailCenteredLayout = !isHomepage && currentPath !== '/about' && currentPath !== '/site';
const navItems = [
  { name: 'Home', href: '/', icon: 'ri-home-5-line', match: (path: string) => path === '/' },
  { name: 'Articles', href: '/blog/1', icon: 'ri-article-line', match: (path: string) => path.startsWith('/blog') || path.startsWith('/archive') || path.startsWith('/tags') },
  { name: 'Memos', href: '/memos', icon: 'ri-quill-pen-line', match: (path: string) => path.startsWith('/memos') },
  { name: 'Reviews', href: '/reviews', icon: 'ri-star-smile-line', match: (path: string) => path.startsWith('/reviews') },
  { name: 'Gallery', href: '/gallery', icon: 'ri-gallery-line', match: (path: string) => path.startsWith('/gallery') },
  { name: 'About', href: '/about', icon: 'ri-user-smile-line', match: (path: string) => path.startsWith('/about') },
];
---

<html lang={config.lang}>
  <BaseHead title={title} description={description} mathjax={mathjax} mermaid={mermaid} ogImage={ogImage} />
  <body class:list={[
    'site-body',
    'rail-open',
    { 'rail-fixed-route': !isHomepage, 'rail-centered-layout': usesRailCenteredLayout },
    bodyClass,
  ]}>
    <script is:inline>
      (() => {
        try {
          if (sessionStorage.getItem('terminal4-loaded')) document.documentElement.dataset.loaderSeen = 'true';
        } catch (_) {}
        if (window.matchMedia('(max-width: 900px)').matches) document.body.classList.remove('rail-open');
      })();
    </script>

    <div class="site-loader" id="site-loader" aria-label="Loading page" role="status">
      <img src={getUrl('/loading.png')} alt="Loading" />
    </div>

    <aside class="side-rail" id="side-rail" aria-label="Main navigation">
      <nav class="rail-nav">
        {navItems.map((item) => (
          <a
            class:list={['rail-link', { active: item.match(currentPath) }]}
            href={getUrl(item.href)}
            aria-label={item.name}
            aria-current={item.match(currentPath) ? 'page' : undefined}
          >
            <i class={item.icon}></i>
            <span>{item.name}</span>
          </a>
        ))}
      </nav>
      <a class="rail-side-icon" href={getUrl('/site')} aria-label="About this site">
        <img src={getUrl('/assets/ui/side-icon.png')} width="111" height="102" alt="" />
      </a>
    </aside>

    <button
      class="rail-toggle"
      id="rail-menu-toggle"
      type="button"
      aria-label="Close navigation"
      aria-controls="side-rail"
      aria-expanded="true"
      data-homepage={isHomepage ? 'true' : 'false'}
    >
      <span></span><span></span><span></span>
    </button>
    <button class="rail-backdrop" id="rail-backdrop" type="button" aria-label="Close navigation"></button>

    <div class="site-stage">
      <main class:list={['site-content', contentClass]} id="app"><slot /></main>
      <GlobalFooter />
    </div>
  </body>
</html>

<script>
  function initSiteShell() {
    const root = document.documentElement;
    const loader = document.querySelector<HTMLElement>('#site-loader');
    const toggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
    const backdrop = document.querySelector<HTMLButtonElement>('#rail-backdrop');
    const mobileRail = window.matchMedia('(max-width: 900px)');

    if (loader && root.dataset.loaderSeen !== 'true') {
      const shownAt = performance.now();
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let loadingFinished = false;
      const finishLoading = () => {
        if (loadingFinished) return;
        loadingFinished = true;
        const minimumVisible = reducedMotion ? 0 : 250;
        const remaining = Math.max(0, minimumVisible - (performance.now() - shownAt));
        window.setTimeout(() => {
          loader.classList.add('is-leaving');
          root.dataset.loaderSeen = 'true';
          try { sessionStorage.setItem('terminal4-loaded', 'true'); } catch (_) {}
          window.setTimeout(() => loader.remove(), reducedMotion ? 20 : 560);
        }, remaining);
      };
      if (document.readyState === 'complete') finishLoading();
      else {
        window.addEventListener('load', finishLoading, { once: true });
        window.setTimeout(finishLoading, 1600);
      }
    }

    if (!toggle) return;

    const setRail = (open: boolean) => {
      const currentToggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
      document.body.classList.toggle('rail-open', open);
      currentToggle?.setAttribute('aria-expanded', String(open));
      currentToggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    const syncRailMode = () => {
      const currentToggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
      if (!currentToggle) return;
      const fixedOnDesktop = currentToggle.dataset.homepage !== 'true' && !mobileRail.matches;
      currentToggle.disabled = fixedOnDesktop;
      currentToggle.tabIndex = fixedOnDesktop ? -1 : 0;
      currentToggle.setAttribute('aria-hidden', String(fixedOnDesktop));
      setRail(!mobileRail.matches);
    };

    syncRailMode();

    if (toggle.dataset.ready !== 'true') {
      toggle.dataset.ready = 'true';
      toggle.addEventListener('click', () => setRail(!document.body.classList.contains('rail-open')));
      backdrop?.addEventListener('click', () => setRail(false));
      document.body.addEventListener('keydown', (event) => {
        const currentToggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
        if (event.key === 'Escape' && !currentToggle?.disabled && document.body.classList.contains('rail-open')) setRail(false);
      });
    }

    if (root.dataset.railMediaBound !== 'true') {
      root.dataset.railMediaBound = 'true';
      mobileRail.addEventListener('change', syncRailMode);
    }
  }

  document.addEventListener('astro:page-load', initSiteShell);
</script>
