---
import BaseHead from '@/components/BaseHead.astro';
import { config } from '@/consts';
import getUrl from '@/utils/getUrl';
import GlobalFooter from '@/components/GlobalFooter.astro';
import { homeConfig } from '@/config/home';

interface Props {
  title?: string;
  description?: string;
  mathjax?: boolean;
  mermaid?: boolean;
  ogImage?: string;
  contentClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  mathjax = false,
  mermaid = false,
  ogImage,
  contentClass = '',
  bodyClass = '',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHomepage = currentPath === '/';
const usesRailCenteredLayout = !isHomepage && currentPath !== '/about' && currentPath !== '/site';
const loaderFrames = homeConfig.hero.loader.frames.map(getUrl);
const navItems = [
  { name: 'Home', href: '/', icon: 'ri-home-5-line', match: (path: string) => path === '/' },
  { name: 'Articles', href: '/articles', icon: 'ri-article-line', match: (path: string) => path.startsWith('/articles') || path.startsWith('/blog') || path.startsWith('/archive') || path.startsWith('/tags') },
  { name: 'Memos', href: '/memos', icon: 'ri-quill-pen-line', match: (path: string) => path.startsWith('/memos') },
  { name: 'Reviews', href: '/reviews', icon: 'ri-star-smile-line', match: (path: string) => path.startsWith('/reviews') },
  { name: 'Gallery', href: '/gallery', icon: 'ri-gallery-line', match: (path: string) => path.startsWith('/gallery') },
  { name: 'About', href: '/about', icon: 'ri-user-smile-line', match: (path: string) => path.startsWith('/about') },
];
---

<html lang={config.lang}>
  <BaseHead title={title} description={description} mathjax={mathjax} mermaid={mermaid} ogImage={ogImage} />
  <body class:list={[
    'site-body',
    'rail-open',
    { 'rail-fixed-route': !isHomepage, 'rail-centered-layout': usesRailCenteredLayout },
    bodyClass,
  ]}>
    <a class="skip-link" href="#app">Skip to content</a>
    <script is:inline>
      (() => {
        try {
          if (sessionStorage.getItem('terminal4-home-loaded')) document.documentElement.dataset.homeLoaderSeen = 'true';
        } catch (_) {}
        if (window.matchMedia('(max-width: 900px)').matches) document.body.classList.remove('rail-open');
      })();
    </script>

    {isHomepage && (
      <div class="site-loader" id="site-loader" aria-label="Loading homepage" role="status">
        <div class="site-loader-art" aria-hidden="true">
          {loaderFrames.map((frame, index) => (
            <img
              class:list={['site-loader-frame', { 'is-active': index === 0 }]}
              src={frame}
              width="1920"
              height="1080"
              alt=""
            />
          ))}
        </div>
      </div>
    )}
    <div class="route-progress" id="route-progress" aria-hidden="true"></div>
    <slot name="viewport-decoration" />

    <aside class="side-rail" id="side-rail" aria-label="Main navigation">
      <nav class="rail-nav">
        {navItems.map((item) => (
          <a
            class:list={['rail-link', { active: item.match(currentPath) }]}
            href={getUrl(item.href)}
            aria-label={item.name}
            aria-current={item.match(currentPath) ? 'page' : undefined}
            data-cursor-label={item.name}
          >
            <i class={item.icon}></i>
          </a>
        ))}
      </nav>
      <a class="rail-side-icon" href={getUrl('/site')} aria-label="About this site" data-cursor-label="About this site">
        <img src={getUrl('/assets/ui/side-icon.png')} width="111" height="102" alt="" />
      </a>
    </aside>
    <span class="rail-cursor-label" id="rail-cursor-label" aria-hidden="true" hidden></span>

    <button
      class="rail-toggle"
      id="rail-menu-toggle"
      type="button"
      aria-label="Close navigation"
      aria-controls="side-rail"
      aria-expanded="true"
      data-homepage={isHomepage ? 'true' : 'false'}
    >
      <span></span><span></span><span></span>
    </button>
    <button class="rail-backdrop" id="rail-backdrop" type="button" aria-label="Close navigation"></button>

    <div class="site-stage">
      <main class:list={['site-content', contentClass]} id="app"><slot /></main>
      <GlobalFooter />
    </div>
  </body>
</html>

<script>
  function initSiteShell() {
    const root = document.documentElement;
    const loader = document.querySelector<HTMLElement>('#site-loader');
    const toggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
    const backdrop = document.querySelector<HTMLButtonElement>('#rail-backdrop');
    const rail = document.querySelector<HTMLElement>('#side-rail');
    const railCursorLabel = document.querySelector<HTMLElement>('#rail-cursor-label');
    const mobileRail = window.matchMedia('(max-width: 900px)');

    if (loader && root.dataset.homeLoaderSeen !== 'true' && loader.dataset.ready !== 'true') {
      loader.dataset.ready = 'true';
      const shownAt = performance.now();
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const loaderFrames = [...loader.querySelectorAll<HTMLElement>('.site-loader-frame')];
      let loaderFrame = 0;
      const loaderTimer = reducedMotion || loaderFrames.length < 2
        ? undefined
        : window.setInterval(() => {
          loaderFrames[loaderFrame]?.classList.remove('is-active');
          loaderFrame = (loaderFrame + 1) % loaderFrames.length;
          loaderFrames[loaderFrame]?.classList.add('is-active');
        }, 100);
      let finished = false;
      const finishLoading = () => {
        if (finished) return;
        finished = true;
        const remaining = Math.max(0, (reducedMotion ? 0 : 300) - (performance.now() - shownAt));
        window.setTimeout(() => {
          loader.classList.add('is-leaving');
          try { sessionStorage.setItem('terminal4-home-loaded', 'true'); } catch (_) {}
          window.setTimeout(() => {
            if (loaderTimer !== undefined) window.clearInterval(loaderTimer);
            root.dataset.homeLoaderSeen = 'true';
            loader.remove();
            document.dispatchEvent(new CustomEvent('terminal4:home-loader-cleared'));
          }, reducedMotion ? 20 : 560);
        }, remaining);
      };
      if (document.readyState === 'complete') finishLoading();
      else {
        window.addEventListener('load', finishLoading, { once: true });
        window.setTimeout(finishLoading, 1600);
      }
    }

    if (!toggle) return;

    if (rail && railCursorLabel && rail.dataset.cursorLabelsReady !== 'true') {
      rail.dataset.cursorLabelsReady = 'true';
      const hideCursorLabel = () => { railCursorLabel.hidden = true; };
      const showCursorLabel = (item: HTMLElement, clientX: number, clientY: number) => {
        const label = item.dataset.cursorLabel;
        if (!label) return hideCursorLabel();
        railCursorLabel.textContent = label;
        railCursorLabel.hidden = false;
        const width = railCursorLabel.offsetWidth;
        const height = railCursorLabel.offsetHeight;
        const left = clientX + width + 24 > window.innerWidth ? clientX - width - 16 : clientX + 16;
        const top = clientY + height + 24 > window.innerHeight ? clientY - height - 16 : clientY + 16;
        railCursorLabel.style.left = `${Math.max(8, left)}px`;
        railCursorLabel.style.top = `${Math.max(8, top)}px`;
      };
      rail.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return hideCursorLabel();
        const item = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-cursor-label]') : null;
        if (item) showCursorLabel(item, event.clientX, event.clientY);
        else hideCursorLabel();
      });
      rail.addEventListener('pointerleave', hideCursorLabel);
      rail.addEventListener('pointerdown', hideCursorLabel);
      rail.addEventListener('focusin', (event) => {
        const item = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-cursor-label]') : null;
        if (!item) return;
        const rect = item.getBoundingClientRect();
        showCursorLabel(item, rect.right, rect.top + rect.height / 2);
      });
      rail.addEventListener('focusout', hideCursorLabel);
    }

    const setRail = (open: boolean) => {
      const currentToggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
      document.body.classList.toggle('rail-open', open);
      currentToggle?.setAttribute('aria-expanded', String(open));
      currentToggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    const syncRailMode = () => {
      const currentToggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
      if (!currentToggle) return;
      const fixedOnDesktop = currentToggle.dataset.homepage !== 'true' && !mobileRail.matches;
      currentToggle.disabled = fixedOnDesktop;
      currentToggle.tabIndex = fixedOnDesktop ? -1 : 0;
      currentToggle.setAttribute('aria-hidden', String(fixedOnDesktop));
      setRail(!mobileRail.matches);
    };

    syncRailMode();

    if (toggle.dataset.ready !== 'true') {
      toggle.dataset.ready = 'true';
      toggle.addEventListener('click', () => setRail(!document.body.classList.contains('rail-open')));
      backdrop?.addEventListener('click', () => setRail(false));
      document.body.addEventListener('keydown', (event) => {
        const currentToggle = document.querySelector<HTMLButtonElement>('#rail-menu-toggle');
        if (event.key === 'Escape' && !currentToggle?.disabled && document.body.classList.contains('rail-open')) setRail(false);
      });
    }

    if (root.dataset.railMediaBound !== 'true') {
      root.dataset.railMediaBound = 'true';
      mobileRail.addEventListener('change', syncRailMode);
    }
  }

  document.addEventListener('astro:page-load', initSiteShell);

  if (document.documentElement.dataset.routeProgressBound !== 'true') {
    document.documentElement.dataset.routeProgressBound = 'true';
    const setProgress = (active: boolean) => document.querySelector('#route-progress')?.classList.toggle('is-active', active);
    document.addEventListener('astro:before-preparation', () => setProgress(true));
    document.addEventListener('astro:page-load', () => setProgress(false));
  }
</script>
