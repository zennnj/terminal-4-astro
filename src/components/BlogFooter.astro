---
import {site} from "@/consts";
import {formatDate} from "@/utils/formatDate.js";
const {title, date, url} = Astro.props;
---

<div class="border-l-4 my-4 p-4 border-skin-base bg-skin-card break-all">
  {title ?
    <div>Title: {title}</div> : ''}
  {
    site.author ?
      <div>Author: {site.author}</div> : ''
  }

  {
    date ?
      <div>Published: {formatDate(date)}</div> : ''
  }
  {
    site.url?   <div>
      Original link: <a href={site.url + url} class="hover:text-skin-active">{site.url + url}</a>
    </div>: ''
  }
</div>
