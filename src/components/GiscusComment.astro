<div class="giscus"></div>

<script>
  import { comment } from "../consts";

  function loadGiscus() {
    const container = document.querySelector(".giscus");
    if (!comment.enable || comment.type !== "giscus" || !container) return;
    // A hoisted <script src="..."> only runs once under ClientRouter, so the
    // Giscus iframe would be missing on the second page visited. Dynamically
    // (re)inserting the script on every page-load forces the browser to execute
    // it each time and re-render Giscus into the fresh container.
    container.innerHTML = "";
    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    for (const [key, value] of Object.entries(comment.giscusConfig)) {
      if (value !== null && value !== "") script.setAttribute(key, value);
    }
    container.appendChild(script);
  }

  document.addEventListener("astro:page-load", loadGiscus);
</script>
