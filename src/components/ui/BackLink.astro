---
import getUrl from '@/utils/getUrl';

interface Props { href: string; label: string; }
const { href, label } = Astro.props;
---

<a class="back-link" href={getUrl(href)}><i class="ri-arrow-left-line" aria-hidden="true"></i><span>{label}</span></a>

<style>
  .back-link {
    display: inline-flex;
    width: fit-content;
    min-height: 2.5rem;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    color: var(--p4-purple);
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: .1em;
    transition: color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
  }
  .back-link:hover, .back-link:focus-visible { color: var(--p4-coral); transform: translateX(-.2rem); }
</style>
