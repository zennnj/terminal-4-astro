---
interface Props {
  id?: string;
  standalone?: boolean;
  force?: boolean;
  path?: string;
}

const { id = 'waline', standalone = false, force = false, path = '' } = Astro.props;
---

<div id={id} data-waline-root data-standalone={standalone ? 'true' : 'false'} data-force={force ? 'true' : 'false'} data-waline-path={path}></div>

<script>
  import { init } from '@waline/client';
  import { comment } from '../consts';
  import '@waline/client/style';

  const walineInstances = new Map<string, ReturnType<typeof init>>();
  const ossUploadEnabled = import.meta.env.PUBLIC_OSS_UPLOAD_ENABLED === 'true';
  const configuredMaxFileSize = Number(import.meta.env.PUBLIC_OSS_MAX_FILE_SIZE_MB);
  const maxFileSizeMb = Number.isFinite(configuredMaxFileSize) && configuredMaxFileSize > 0
    ? configuredMaxFileSize
    : 5;

  interface OssUploadPolicy {
    host: string;
    publicUrl: string;
    fields: Record<string, string>;
  }

  async function uploadToOss(file: File): Promise<string> {
    if (!file.type.startsWith('image/')) throw new Error('Only image files can be uploaded.');
    if (file.size > maxFileSizeMb * 1024 * 1024) {
      throw new Error(`Images must be smaller than ${maxFileSizeMb} MB.`);
    }

    const policyResponse = await fetch('/.netlify/functions/oss-upload-policy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ contentType: file.type, size: file.size }),
    });
    const policy = await policyResponse.json().catch(() => null) as (OssUploadPolicy & { message?: string }) | null;
    if (!policyResponse.ok || !policy?.host || !policy.publicUrl || !policy.fields) {
      throw new Error(policy?.message || `Unable to authorize image upload (${policyResponse.status}).`);
    }

    const formData = new FormData();
    Object.entries(policy.fields).forEach(([name, value]) => formData.append(name, value));
    // OSS requires the file field to be the final multipart form field.
    formData.append('file', file);

    const response = await fetch(policy.host, {
      method: 'POST',
      body: formData,
    });
    if (!response.ok) throw new Error(`Image upload failed (${response.status}).`);
    return policy.publicUrl;
  }

  function destroyWaline(root: HTMLElement) {
    walineInstances.get(root.id)?.destroy();
    walineInstances.delete(root.id);
    root.replaceChildren();
    delete root.dataset.mounted;
  }

  function mountWaline(root: HTMLElement, forceRemount = false) {
    const standalone = root.dataset.standalone === 'true';
    const force = root.dataset.force === 'true';
    if ((!comment.enable && !standalone && !force) || comment.type !== 'waline' || !comment.walineConfig.serverUrl) return;
    if (root.closest('[hidden]')) return;
    if (forceRemount) destroyWaline(root);
    if (root.dataset.mounted === 'true') return;

    // An element with this id may have belonged to the previous Astro page.
    walineInstances.get(root.id)?.destroy();
    const instance = init({
      el: root,
      comment: true,
      path: root.dataset.walinePath || window.location.pathname.replace(/\/$/, ''),
      serverURL: comment.walineConfig.serverUrl,
      lang: comment.walineConfig.lang,
      pageSize: comment.walineConfig.pageSize,
      pageview: comment.walineConfig.pageview,
      // The browser receives a short-lived, single-object policy. The OSS
      // AccessKey remains inside the Netlify Function runtime.
      imageUploader: ossUploadEnabled ? uploadToOss : false,
      reaction: false,
      meta: standalone ? [] : ['nick', 'mail', 'link'],
      requiredMeta: standalone ? [] : comment.walineConfig.requiredMeta,
      login: standalone ? 'disable' : 'enable',
      locale: standalone ? { placeholder: 'Write anonymously...' } : undefined,
      dark: 'html[data-theme="dark"]',
    });
    walineInstances.set(root.id, instance);
    root.dataset.mounted = 'true';
  }

  function initWaline(event?: Event) {
    const detail = event instanceof CustomEvent ? event.detail : undefined;
    const targetId = detail?.id as string | undefined;
    const forceRemount = detail?.force === true;
    const roots = [...document.querySelectorAll<HTMLElement>('[data-waline-root]')];

    roots.forEach((root) => {
      if (targetId && root.id !== targetId) {
        destroyWaline(root);
        return;
      }
      if (!targetId || root.id === targetId) mountWaline(root, forceRemount);
    });
  }

  document.addEventListener('astro:page-load', initWaline);
  window.addEventListener('waline:mount', initWaline as EventListener);
</script>
