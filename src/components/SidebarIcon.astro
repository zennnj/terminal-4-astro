---
<button type="button" id="aside-btn" class="header-btn" title="Open Aside Bar" aria-label="auto" aria-live="polite">
  <i class="ri-user-line"/>
</button>
<button type="button" id="aside-close-btn" class="header-btn hidden" title="Close Aside Bar" aria-label="auto" aria-live="polite">
  <i class="ri-close-fill"/>
</button>

<div id="blog-aside" class="absolute top-16 bg-skin-fill right-0 blog-aside hidden">

</div>

<script>
  // ClientRouter swaps <body> on every navigation, so direct addEventListener
  // on the buttons is lost after the first page. Delegate from `document`
  // (never swapped) and re-query the elements on each click. Guarded so it
  // stays single-bound even if the script re-executes.
  if (!window.__asideIconBound) {
    window.__asideIconBound = true;
    const toggleHidden = (arr) => arr.forEach((el) => el?.classList.toggle("hidden"));

    document.addEventListener("click", (event) => {
      if (event.target.closest("#aside-btn")) {
        const menuIcon = document.getElementById("menu-icon");
        if (menuIcon && menuIcon.classList.contains("hidden")) {
          // mobile menu is open -> close it so only the aside shows
          toggleHidden([
            document.getElementById("menu-icon"),
            document.getElementById("menu-icon-close"),
            document.getElementById("mobile-menu"),
          ]);
        }
        toggleHidden([
          document.getElementById("aside-btn"),
          document.getElementById("aside-close-btn"),
          document.getElementById("personal-info"),
        ]);
      } else if (event.target.closest("#aside-close-btn")) {
        toggleHidden([
          document.getElementById("aside-close-btn"),
          document.getElementById("personal-info"),
          document.getElementById("aside-btn"),
        ]);
      }
    });
  }
</script>
