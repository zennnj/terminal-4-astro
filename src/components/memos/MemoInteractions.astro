<script>
  function initMemoViews() {
    const buttons = [...document.querySelectorAll('[data-memo-view]')].filter((item): item is HTMLButtonElement => item instanceof HTMLButtonElement);
    const panels = [...document.querySelectorAll('[data-memo-panel]')].filter((item): item is HTMLElement => item instanceof HTMLElement);
    const reload = document.querySelector('#junk-reload');

    const decorateJunk = () => {
      const root = document.querySelector('#waline-junk');
      if (!(root instanceof HTMLElement)) return;
      const cards = [...root.querySelectorAll('.wl-card')].filter((item): item is HTMLElement => item instanceof HTMLElement);
      const countText = root.querySelector('.wl-count')?.textContent ?? '';
      const parsedTotal = Number.parseInt(countText.match(/\d+/)?.[0] ?? '', 10);
      const total = Number.isFinite(parsedTotal) ? parsedTotal : cards.length;
      cards.forEach((card, index) => {
        let heading = card.querySelector('.junk-post-heading');
        if (!(heading instanceof HTMLElement)) {
          heading = document.createElement('div');
          heading.className = 'junk-post-heading';
          card.prepend(heading);
        }
        const time = card.querySelector('.wl-time');
        const rawDate = time?.getAttribute('title') || time?.getAttribute('datetime') || '';
        const date = rawDate ? new Date(rawDate.replace(' ', 'T')) : null;
        const dateLabel = date && !Number.isNaN(date.valueOf())
          ? `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`
          : (time?.textContent?.trim() ?? '');
        const label = `#${Math.max(1, total - index)}${dateLabel ? `  ${dateLabel}` : ''}`;
        if (heading.textContent !== label) heading.textContent = label;
      });
    };

    const junkRoot = document.querySelector('#waline-junk');
    if (junkRoot) new MutationObserver(decorateJunk).observe(junkRoot, { childList: true, subtree: true });
    const setView = (view: string) => {
      buttons.forEach((button) => {
        const active = button.dataset.memoView === view;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.memoPanel !== view; });
      const id = view === 'junk' ? 'waline-junk' : 'waline-memos';
      requestAnimationFrame(() => window.dispatchEvent(new CustomEvent('waline:mount', { detail: { id } })));
      const url = new URL(location.href);
      if (view === 'junk') url.searchParams.set('view', 'junk');
      else url.searchParams.delete('view');
      history.replaceState(history.state, '', url);
    };
    buttons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.memoView ?? 'memos')));
    if (reload instanceof HTMLButtonElement) reload.addEventListener('click', () => window.dispatchEvent(new CustomEvent('waline:mount', { detail: { id: 'waline-junk', force: true } })));
    setView(new URLSearchParams(location.search).get('view') === 'junk' ? 'junk' : 'memos');
  }
  document.addEventListener('astro:page-load', initMemoViews);
</script>
