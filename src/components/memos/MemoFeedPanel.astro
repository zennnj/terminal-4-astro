---
import type { CollectionEntry } from 'astro:content';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import MemoAside from './MemoAside.astro';
import MemoCard from './MemoCard.astro';
import { memoConfig } from '@/config/memos';

interface Props { entries: CollectionEntry<'memos'>[]; }
const { entries } = Astro.props;
---

<section data-memo-panel="memos">
  <PageHeader title="MEMOS" eyebrow={memoConfig.eyebrow} description={memoConfig.description} compact />
  <div class="memo-layout">
    <MemoAside />
    <div class="memo-stream" aria-label="Local memo feed">
      {entries.length > 0
        ? entries.map((memo) => <MemoCard {memo} avatar={memoConfig.avatar} />)
        : <EmptyState title="NO MEMOS YET" description="Add a Markdown file to src/content/memos to publish one." />}
    </div>
  </div>
</section>
