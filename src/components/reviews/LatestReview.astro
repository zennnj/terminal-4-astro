---
import type { CollectionEntry } from 'astro:content';
import getUrl from '@/utils/getUrl';
import { getReviewTypeChineseLabel } from '@/config/reviews';
import { formatFormalChineseDate, getReviewBodyExcerpt, getReviewDisplayName, toTraditionalReviewText } from '@/utils/reviews';

interface Props {
  review?: CollectionEntry<'reviews'>;
  reviews: CollectionEntry<'reviews'>[];
}

const { review, reviews } = Astro.props;
const displayName = review ? toTraditionalReviewText(getReviewDisplayName(review.data)) : '暫無評論';
const titleCharacters = [...displayName];
const titleVisualLength = titleCharacters.reduce(
  (length, character) => length + (/^[\u0000-\u007f]$/.test(character) ? 0.55 : 1),
  0,
);
const splitTitle = titleVisualLength > 10;
const titleMidpoint = Math.ceil(titleCharacters.length / 2);
const titleLines = splitTitle
  ? [titleCharacters.slice(0, titleMidpoint).join(''), titleCharacters.slice(titleMidpoint).join('')]
  : [displayName];
const chineseDate = review ? formatFormalChineseDate(review.data.date) : null;
const traditionalExcerpt = review
  ? toTraditionalReviewText(getReviewBodyExcerpt(review.body) || '這篇評論還沒有正文。')
  : '';
const traditionalType = review ? toTraditionalReviewText(getReviewTypeChineseLabel(review.data.type)) : '';
const reviewPaths = reviews.map((item) => getUrl(`/reviews/${item.id}`));
const fallbackPath = reviewPaths[0] ?? getUrl('/reviews');
---

<section class="recent-review" aria-label="最近一篇評論">
  <div class="recent-burst" aria-hidden="true">
    <img src={getUrl('/assets/reviews/multigle-orange.png')} width="260" height="269" alt="" />
    <svg viewBox="0 0 260 269">
      <defs><path id="recently-circle" d="M 68 135 A 62 62 0 1 1 192 135 A 62 62 0 1 1 68 135" /></defs>
      <text textLength="382" lengthAdjust="spacing"><textPath href="#recently-circle" startOffset="1%">RECENTLY · RECENTLY ·</textPath></text>
    </svg>
  </div>

  <img class="recent-white-burst" src={getUrl('/assets/reviews/multigle-white.png')} width="522" height="550" alt="" aria-hidden="true" />

  {review ? (
    <a class="recent-ticket" href={getUrl(`/reviews/${review.id}`)} lang="zh-Hant">
      <span class:list={['recent-title', { 'is-multiline': splitTitle }]}>
        {titleLines.map((line) => <span>{line}</span>)}
      </span>
      <time class="recent-date" datetime={review.data.date.toISOString()}>
        <span>{chineseDate?.year}</span><span>{chineseDate?.monthDay}</span>
      </time>
      <p class="recent-summary">{traditionalExcerpt}</p>
      <span class="recent-type" aria-label={`類型：${traditionalType}`}>
        {[...traditionalType].map((character) => <span>{character}</span>)}
      </span>
    </a>
  ) : (
    <div class="recent-ticket is-empty" lang="zh-Hant"><span class="recent-title">暫無評論</span></div>
  )}

  <a class="random-review" href={fallbackPath} data-random-review>
    <img src={getUrl('/assets/reviews/label.png')} width="318" height="52" alt="" />
    <span>Random Review</span>
  </a>
  <script is:inline type="application/json" data-review-paths set:html={JSON.stringify(reviewPaths)} />
</section>

<script>
  function bindRandomReview() {
    document.querySelectorAll<HTMLElement>('.recent-review').forEach((section) => {
      if (section.dataset.randomBound === 'true') return;
      section.dataset.randomBound = 'true';
      const link = section.querySelector<HTMLAnchorElement>('[data-random-review]');
      const data = section.querySelector<HTMLScriptElement>('[data-review-paths]');
      if (!link || !data) return;
      let paths: string[] = [];
      try { paths = JSON.parse(data.textContent ?? '[]'); } catch { paths = []; }
      link.addEventListener('click', (event) => {
        if (paths.length === 0) return;
        event.preventDefault();
        window.location.assign(paths[Math.floor(Math.random() * paths.length)]);
      });
    });
  }

  document.addEventListener('astro:page-load', bindRandomReview);
</script>
