---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import getUrl from '@/utils/getUrl';
import { getReviewAccentColor, getReviewTypeLabel } from '@/config/reviews';

interface Props { review?: CollectionEntry<'reviews'>; }
const { review } = Astro.props;
const ReviewContent = review ? (await render(review)).Content : null;
---

<section class="recent-review" aria-label="Latest review">
  {review ? (
    <a class="recent-card" href={getUrl(`/reviews/${review.id}`)}>
      <span class="latest-badge">Latest</span>
      <div class="recent-heading">
        <strong>{review.data.title}{review.data.creator && <span> ({review.data.creator})</span>}</strong>
        <span class="recent-type"><i style={`--accent:${getReviewAccentColor(review.data.type)}`} />{getReviewTypeLabel(review.data.type)}</span>
      </div>
      <div class="recent-excerpt markdown-body">{ReviewContent && <ReviewContent />}</div>
      <span class="recent-more">READ MORE &gt;&gt;&gt;</span>
    </a>
  ) : (
    <div class="recent-card is-empty"><span class="latest-badge">Latest</span><div class="recent-heading"><strong>NO REVIEW YET</strong></div></div>
  )}
</section>

<script>
  function initLatestReviewTilt() {
    const cards = [...document.querySelectorAll<HTMLElement>('.recent-card:not(.is-empty)')];
    cards.forEach((card) => {
      if (card.dataset.tiltReady === 'true') return;
      card.dataset.tiltReady = 'true';
      card.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--tilt-x', `${((event.clientY - rect.top) / rect.height - .5) * -4}deg`);
        card.style.setProperty('--tilt-y', `${((event.clientX - rect.left) / rect.width - .5) * 5}deg`);
        card.style.setProperty('--glow-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        card.style.setProperty('--glow-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--tilt-x');
        card.style.removeProperty('--tilt-y');
      });
    });
  }

  document.addEventListener('astro:page-load', initLatestReviewTilt);
</script>
