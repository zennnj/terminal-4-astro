<header class="article-toolbar">
  <div class="search-control" id="search-control">
    <div class="search-capsule">
      <input id="article-search" type="search" placeholder="type" autocomplete="off" aria-label="Search articles" />
      <button class="search-toggle" id="search-toggle" type="button" aria-label="Open article search" aria-expanded="false" aria-controls="article-search"><i class="ri-search-line"></i></button>
    </div>
  </div>
  <nav class="section-tabs" aria-label="Article view">
    <button class="active" type="button" data-view-button="list" aria-pressed="true">ARTICLE</button>
    <button type="button" data-view-button="archive" aria-pressed="false">ARCHIVE</button>
  </nav>
</header>
