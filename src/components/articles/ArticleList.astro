---
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';
import { dealLabel } from '@/utils/dealLabel';
import getUrl from '@/utils/getUrl';
import PageHeader from '@/components/ui/PageHeader.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;
const postsPerPage = 10;
const initialStart = (currentPage - 1) * postsPerPage;
const initialEnd = initialStart + postsPerPage;
const initialVisible = posts.slice(initialStart, initialEnd).length;
---

<div class="article-primary">
  <PageHeader title="ARTICLE" eyebrow="ARTICLE INDEX" compact />
  <p class="article-list-summary">Page <span id="result-page">{currentPage}</span> · Showing <span id="visible-count">{initialVisible}</span> of <span id="result-count">{totalPosts}</span> posts</p>
  <div class="article-list" id="article-list" data-current-page={currentPage} data-page-size={postsPerPage}>
    {posts.map((post, index) => {
      const postTags = dealLabel(post.data.tags);
      const excerpt = post.data.description?.trim() || (post.body ?? '')
        .replace(/```[\s\S]*?```/g, ' ')
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/[#>*_`~|\-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 120);
      const searchText = `${post.data.title} ${excerpt} ${postTags.join(' ')}`.toLowerCase();
      const words = readingTime(post.body ?? '').words;
      return (
        <article class="article-card" data-filter-item data-tags={postTags.join('|')} data-search={searchText} hidden={index < initialStart || index >= initialEnd}>
          <a href={getUrl(`/blog/${post.id}`)}>
            <time>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h2>{post.data.title}</h2>
            {excerpt && <p class="card-description">{excerpt}{!post.data.description && excerpt.length === 120 ? '…' : ''}</p>}
            <div class="card-footer">
              <span class="word-count"><i class="ri-quill-pen-line"></i>{words} words</span>
              <span class="card-tags">{postTags.map((tag) => <span>#{tag}</span>)}</span>
            </div>
          </a>
        </article>
      );
    })}
    <p class="no-results" id="no-results" hidden>No matching articles.</p>
  </div>
  {totalPages > 1 && (
    <nav class="article-pagination" aria-label="Article pagination" data-article-pagination>
      <a class="previous-posts" data-page-nav="previous" href={getUrl(`/blog/${Math.max(1, currentPage - 1)}`)} hidden={currentPage <= 1}><i class="ri-arrow-left-line"></i> Previous Posts</a>
      <a class="next-posts" data-page-nav="next" href={getUrl(`/blog/${Math.min(totalPages, currentPage + 1)}`)} hidden={currentPage >= totalPages}>Next Posts <i class="ri-arrow-right-line"></i></a>
    </nav>
  )}
</div>
