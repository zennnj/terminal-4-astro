---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[]; }

const { headings = [] } = Astro.props;
const visibleHeadings = headings
  .filter((item) => item.depth >= 1 && item.depth <= 4)
  .map((item, index) => ({ ...item, resolvedSlug: item.slug || `section-${index + 1}` }));
---

<nav id="toc" class="toc-container" aria-label="Table of contents">
  <div class="toc-heading"><i class="ri-list-check"></i>TABLE OF CONTENTS</div>
  <ul>
    {visibleHeadings.map((item) => (
      <li style={`--toc-depth:${item.depth}`}>
        <a title={item.text} href={`#${item.resolvedSlug}`} data-heading-id={item.resolvedSlug}>{item.text}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc-container { position: sticky; top: 1.5rem; max-height: calc(100svh - 3rem); overflow-y: auto; padding: .85rem .7rem 1rem; border-radius: 10px; background: var(--p4-yellow); box-shadow: 0 6px 18px rgba(74, 47, 79, .08); scrollbar-color: color-mix(in srgb, var(--p4-purple) 45%, transparent) transparent; scrollbar-width: thin; }
  .toc-heading { position: sticky; z-index: 2; top: -.85rem; display: flex; align-items: center; gap: .45rem; padding: .25rem 0 .6rem; border-bottom: 1px solid color-mix(in srgb, var(--p4-purple) 30%, transparent); background: var(--p4-yellow); font-size: 15px; }
  ul { display: flex; max-width: 100%; flex-direction: column; gap: .2rem; margin-top: .65rem; }
  li { min-width: 0; }
  a { display: block; overflow: hidden; padding: .25rem .2rem .25rem calc((var(--toc-depth) - 1) * .85rem); color: var(--p4-purple); font-size: 15px; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
  a:hover, a:focus-visible, a.active-heading { color: var(--p4-coral); font-weight: 600; }
</style>

<script>
  function initToc() {
    const toc = document.querySelector<HTMLElement>('#toc');
    if (!toc || toc.dataset.ready === 'true') return;
    toc.dataset.ready = 'true';

    const anchors = [...document.querySelectorAll<HTMLElement>('.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4')];
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    anchors.forEach((anchor, index) => {
      const expectedId = links[index]?.dataset.headingId;
      if (!anchor.id && expectedId) anchor.id = expectedId;
    });
    links.forEach((link) => link.addEventListener('click', (event) => {
      const targetId = link.dataset.headingId;
      const target = targetId ? document.getElementById(targetId) : null;
      if (!targetId || !target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(history.state, '', `#${encodeURIComponent(targetId)}`);
    }));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const index = anchors.indexOf(entry.target as HTMLElement);
        links.forEach((link) => link.classList.remove('active-heading'));
        const active = links[index];
        active?.classList.add('active-heading');
        active?.scrollIntoView({ block: 'nearest' });
      });
    }, { rootMargin: '0px 0px -75% 0px', threshold: 0 });
    anchors.forEach((anchor) => observer.observe(anchor));
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
