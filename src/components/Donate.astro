---
import "@/styles/donate.css";
import {donate} from "@/consts";
---
<div class="mt-4">
  <div class="esa-sponsor">
    <div class="tip flex items-center justify-center my-4">
      {donate.tip}
    </div>
    <div class="flex items-center justify-center">
      <div id="alipay" class="border rounded-tl-lg rounded-bl-lg p-2">
        <img src="/alipay.svg" class="h-4" alt="alipay"/>
      </div>
      <div id="wechatpay" class="border-t border-b p-2">
        <img src="/wechat.svg" class="h-4" alt="wechat"/>
      </div>
      <a class="border rounded-tr-lg rounded-br-lg p-2" href={donate.paypalUrl} target="_blank">
        <img src="/paypal.svg" class="h-4" alt="paypal"/>
      </a>
    </div>
    <div class="qrshow">
      <img src={donate.alipayQRCode} alt="alipayQRCode"/>
    </div>
    <div class="qrshow">
      <img src={donate.wechatQRCode} alt="wechatQRCode"/>
    </div>
  </div>
</div>

<script>
  import {donate} from "../consts";

  // ClientRouter swaps <body> on navigation, so #alipay/#wechatpay are fresh
  // on each page. Re-bind the hover handlers on astro:page-load.
  function bindDonate() {
    const qrDiv = document.getElementsByClassName("qrshow");
    const aliDiv = document.getElementById("alipay");
    const wechatDiv = document.getElementById("wechatpay");

    if (donate.alipayQRCode) {
      aliDiv?.addEventListener("mouseenter", () => {
        qrDiv[0]?.style.setProperty("display", "block");
      });
      aliDiv?.addEventListener("mouseleave", () => {
        qrDiv[0]?.style.setProperty("display", "none");
      });
    }
    if (donate.wechatQRCode) {
      wechatDiv?.addEventListener("mouseenter", () => {
        qrDiv[1]?.style.setProperty("display", "block");
      });
      wechatDiv?.addEventListener("mouseleave", () => {
        qrDiv[1]?.style.setProperty("display", "none");
      });
    }
  }

  document.addEventListener("astro:page-load", bindDonate);
</script>
